{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDirs": [".", "public"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true
  },
  "include": ["public/*.ts", "themes/**/*.ts"],
  "exclude": ["node_modules", "themes/old-stuffs"]
}
